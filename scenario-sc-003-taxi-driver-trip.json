{
  "version": 2,
  "id": "scenario-set-sc-003-taxi-driver-trip",
  "name": "Taxi Driver End-to-End Trip Workflow",
  "description": "Сквозной рабочий набор сценариев поездки водителя такси с контролем FSM состояний: accept-order -> arrived -> start-trip -> finish-trip -> become-available.",
  "scenarios": [
    {
      "id": "sc003-accept-order",
      "name": "1. Принять заказ",
      "activation": {
        "type": "voice",
        "value": "voice.accept-order"
      },
      "expectedPhrase": "Принять заказ",
      "aliases": [
        "Принимаю заказ",
        "Беру заказ"
      ],
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.order.accepted",
            "payload": {
              "orderId": 1001
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "intent": "ACCEPT_ORDER",
      "triggerPhrases": [
        "прими заказ",
        "принять заказ"
      ]
    },
    {
      "id": "sc003-arrived",
      "name": "2. Я приехал",
      "activation": {
        "type": "voice",
        "value": "voice.arrived"
      },
      "expectedPhrase": "Я приехал",
      "aliases": [
        "Прибыл",
        "На месте"
      ],
      "steps": [
        {
          "kind": "delay",
          "ms": 300
        },
        {
          "kind": "emit",
          "event": {
            "type": "driver.arrived",
            "payload": {
              "orderId": 1001
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "intent": "DRIVER_ARRIVED",
      "triggerPhrases": [
        "я приехал",
        "я приехала",
        "я на месте",
        "на месте"
      ]
    },
    {
      "id": "sc003-start-trip",
      "name": "3. Начать поездку",
      "activation": {
        "type": "voice",
        "value": "voice.start-trip"
      },
      "expectedPhrase": "Начать поездку",
      "aliases": [
        "Поехали",
        "Начинаем поездку"
      ],
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.trip.started",
            "payload": {
              "orderId": 1001
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "intent": "START_TRIP",
      "triggerPhrases": [
        "начать поездку",
        "поехали",
        "начинаем поездку"
      ]
    },
    {
      "id": "sc003-finish-trip",
      "name": "4. Завершить поездку",
      "activation": {
        "type": "voice",
        "value": "voice.finish-trip"
      },
      "expectedPhrase": "Завершить поездку",
      "aliases": [
        "Поездка завершена",
        "Закончить поездку"
      ],
      "steps": [
        {
          "kind": "delay",
          "ms": 300
        },
        {
          "kind": "emit",
          "event": {
            "type": "driver.trip.finished",
            "payload": {
              "orderId": 1001,
              "payment": "cash"
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "intent": "FINISH_TRIP",
      "triggerPhrases": [
        "завершить поездку",
        "поездка завершена",
        "закончить поездку"
      ]
    },
    {
      "id": "sc003-become-available",
      "name": "5. Водитель свободен",
      "activation": {
        "type": "voice",
        "value": "voice.available"
      },
      "expectedPhrase": "Готов к следующему заказу",
      "aliases": [
        "Свободен",
        "Жду следующий заказ"
      ],
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.available",
            "payload": {
              "driverStatus": "available"
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "intent": "DRIVER_AVAILABLE",
      "triggerPhrases": [
        "свободен",
        "я свободен",
        "готов к следующему заказу",
        "жду следующий заказ"
      ]
    }
  ]
}
