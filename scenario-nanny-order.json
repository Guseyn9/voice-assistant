{
  "version": 1,
  "id": "scenario-set-nanny",
  "name": "Nanny Booking Dialogue",
  "scenarios": [
    {
      "id": "order-nanny",
      "intent": "ORDER_NANNY",
      "triggerPhrases": [
        "нужна няня",
        "заказать няню",
        "поиск няни",
        "order nanny"
      ],
      "requiredSlots": [
        "date",
        "start_time",
        "end_time",
        "children_count",
        "children_ages",
        "location",
        "requirements",
        "selected_nanny",
        "confirmation"
      ],
      "candidateBinding": {
        "targetSlot": "selected_nanny",
        "idField": "id",
        "labelField": "name",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE",
        "unavailableTemplate": "Няня {{targetId}} сейчас недоступна"
      },
      "confirmation": {
        "slot": "confirmation",
        "confirmedValue": "CONFIRMED",
        "rejectedValue": "REJECTED",
        "confirmLabel": "Да",
        "rejectLabel": "Отмена",
        "confirmedMessage": "Заказ подтверждён.",
        "cancelledMessage": "Диалог отменён.",
        "confirmedStatus": "ORDER_CONFIRMED"
      },
      "clarificationPrompts": {
        "date": "Когда нужна няня?",
        "start_time": "Во сколько нужно начать?",
        "end_time": "До скольки нужна няня?",
        "children_count": "Сколько детей?",
        "children_ages": "Какой возраст детей?",
        "location": "Укажите адрес или район",
        "requirements": "Есть ли особые пожелания или требования?",
        "selected_nanny": "Какую няню вы выбираете?",
        "confirmation": "Подтверждаете заказ?"
      },
      "slotExtractors": {
        "date": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(сегодня|today)\\b",
              "value": "сегодня"
            },
            {
              "pattern": "\\b(завтра|tomorrow)\\b",
              "value": "завтра"
            },
            {
              "pattern": "\\b(послезавтра)\\b",
              "value": "послезавтра"
            }
          ]
        },
        "start_time": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(с\\s+четырех|в\\s+четыре|в\\s+16(:00)?|16:00)\\b",
              "value": "16:00"
            },
            {
              "pattern": "\\b(с\\s+трех|в\\s+три|в\\s+15(:00)?|15:00)\\b",
              "value": "15:00"
            },
            {
              "pattern": "\\b(с\\s+десяти|в\\s+10(:00)?|10:00)\\b",
              "value": "10:00"
            },
            {
              "pattern": "\\b(с\\s+девяти|в\\s+9(:00)?|09:00)\\b",
              "value": "09:00"
            }
          ]
        },
        "end_time": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(до\\s+восьми|до\\s+20(:00)?|20:00)\\b",
              "value": "20:00"
            },
            {
              "pattern": "\\b(до\\s+шести|до\\s+18(:00)?|18:00)\\b",
              "value": "18:00"
            },
            {
              "pattern": "\\b(до\\s+пяти|до\\s+17(:00)?|17:00)\\b",
              "value": "17:00"
            }
          ]
        },
        "children_count": {
          "type": "integer",
          "rules": [
            {
              "pattern": "\\b(на\\s+одного|один|1)\\b",
              "value": 1
            },
            {
              "pattern": "\\b(на\\s+двух|двое|двух|2)\\b",
              "value": 2
            },
            {
              "pattern": "\\b(на\\s+трех|трое|трех|3)\\b",
              "value": 3
            }
          ]
        },
        "children_ages": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(3\\s+и\\s+5|3,\\s*5)\\b",
              "value": "3 и 5 лет"
            },
            {
              "pattern": "\\b(5\\s+лет|пять\\s+лет)\\b",
              "value": "5 лет"
            },
            {
              "pattern": "\\b(любой|не\\s+важно)\\b",
              "value": "не указан"
            }
          ]
        },
        "location": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(центр|центральный\\s+район)\\b",
              "value": "Центр"
            },
            {
              "pattern": "\\b(ленина\\s*10|ул\\.?\\s*ленина)\\b",
              "value": "ул. Ленина 10"
            }
          ]
        },
        "requirements": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(без\\s+вредных\\s+привычек)\\b",
              "value": "без вредных привычек"
            {
              },
            {
              "pattern": "\\b(педагогическое\\s+образование)\\b",
              "value": "педагогическое образование"
            },
            {
              "pattern": "\\b(нет|без\\s+требований|стандартные)\\b",
              "value": "без особых требований"
            }
          ]
        },
        "candidate_index": {
          "type": "integer",
          "rules": [
            {
              "pattern": "\\b(перв(ая|ую|ый)|вариант\\s+1)\\b",
              "value": 1
            },
            {
              "pattern": "\\b(втор(ая|ую|ой)|вариант\\s+2)\\b",
              "value": 2
            }
          ]
        },
        "candidate_name": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(мари[яю]|maria)\\b",
              "value": "Мария"
            },
            {
              "pattern": "\\b(анн[ау]|anna)\\b",
              "value": "Анна"
            },
            {
              "pattern": "\\b(ирин[ау]|irina)\\b",
              "value": "Ирина"
            },
            {
              "pattern": "\\b(ольг[ау]|olga)\\b",
              "value": "Ольга"
            }
          ]
        },
        "confirmation": {
          "type": "enum",
          "rules": [
            {
              "pattern": "\\b(да|подтверждаю|да,\\s*подтверждаю|верно|confirm)\\b",
              "value": "CONFIRMED"
            },
            {
              "pattern": "\\b(отмена|отменяю|отменить|отбой|reject|cancel|нет,\\s*отмена)\\b",
              "value": "REJECTED"
            }
          ]
        }
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "nanny.order.confirmed",
            "payload": {}
          }
        }
      ]
    }
  ]
}
