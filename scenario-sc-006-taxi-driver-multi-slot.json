{
  "version": 2,
  "id": "scenario-set-sc-006-taxi-driver-multi-slot",
  "name": "Taxi Driver Multi-Slot Dialogue Workflow",
  "description": "Многошаговая голосовая операция водителя такси с двумя обязательными слотами (orderId и payment) в рамках одного Intent ACCEPT_ORDER.",
  "scenarios": [
    {
      "id": "sc006-accept-order-multi-slot",
      "name": "Принятие заказа с последовательным заполнением orderId и payment",
      "activation": {
        "type": "voice",
        "value": "voice.accept-order"
      },
      "intent": "ACCEPT_ORDER",
      "requiredSlots": [
        "orderId",
        "payment"
      ],
      "clarificationPrompts": {
        "orderId": "Какой заказ?",
        "payment": "Какой способ оплаты?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.order.accepted",
            "payload": {
              "orderId": "{{slots.orderId}}",
              "payment": "{{slots.payment}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "aliases": [
        "прими заказ",
        "принять заказ"
      ],
      "slotExtractors": {
        "orderId": {
          "type": "integer",
          "pattern": "\\b\\d+\\b",
          "priority": 100
        },
        "payment": {
          "type": "enum",
          "mapping": {
            "card": [
              "картой",
              "карта",
              "безнал",
              "card"
            ],
            "cash": [
              "наличными",
              "наличка",
              "cash"
            ]
          },
          "priority": 100
        }
      }
    },
    {
      "id": "sc006-driver-arrived",
      "name": "Прибытие к пассажиру",
      "activation": {
        "type": "voice",
        "value": "voice.arrived"
      },
      "expectedPhrase": "Я приехал",
      "aliases": [
        "прибыл",
        "на месте"
      ],
      "intent": "DRIVER_ARRIVED",
      "requiredSlots": [],
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.arrived",
            "payload": {
              "orderId": 1001
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    }
  ]
}
