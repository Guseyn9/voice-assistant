{
  "version": 2,
  "id": "scenario-set-platform-010-multi-context",
  "name": "Platform Multi-Context Session Manager Scenario",
  "description": "Платформенный сценарий для валидации удержания нескольких одновременных Dialogue Contexts, маршрутизации и изолированного исполнения.",
  "scenarios": [
    {
      "id": "platform010-accept-order",
      "name": "Принятие заказа в многоконтекстной сессии",
      "activation": {
        "type": "voice",
        "value": "voice.accept-order"
      },
      "aliases": ["прими заказ"],
      "intent": "ACCEPT_ORDER",
      "requiredSlots": ["orderId", "payment"],
      "slotExtractors": {
        "orderId": {
          "type": "integer",
          "pattern": "\\b\\d+\\b"
        },
        "payment": {
          "type": "enum",
          "mapping": {
            "card": ["картой", "карта", "безнал", "card"],
            "cash": ["наличными", "наличка", "cash"]
          }
        }
      },
      "clarificationPrompts": {
        "orderId": "Какой заказ?",
        "payment": "Какой способ оплаты?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.order.accepted",
            "payload": {
              "orderId": "{{slots.orderId}}",
              "payment": "{{slots.payment}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    }
  ]
}
