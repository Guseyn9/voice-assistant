{
  "version": 2,
  "id": "scenario-set-sc-007-taxi-driver-context-isolation",
  "name": "Taxi Driver Context Isolation Workflow",
  "description": "Сценарий проверки строгой изоляции контекста при переключении между заказами без смешивания slots и actions.",
  "scenarios": [
    {
      "id": "sc007-accept-order-isolation",
      "name": "Принятие заказа с изолированным Dialogue State",
      "activation": {
        "type": "voice",
        "value": "voice.accept-order"
      },
      "aliases": ["прими заказ"],
      "intent": "ACCEPT_ORDER",
      "requiredSlots": [
        "orderId",
        "payment"
      ],
      "slotExtractors": {
        "orderId": { "type": "integer", "pattern": "\\\\b\\\\d+\\\\b" },
        "payment": {
          "type": "enum",
          "mapping": {
            "card": ["картой", "карта", "безнал", "card"],
            "cash": ["наличными", "наличка", "cash"]
          }
        }
      },
      "clarificationPrompts": {
        "orderId": "Какой заказ?",
        "payment": "Какой способ оплаты?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.order.accepted",
            "payload": {
              "orderId": "{{slots.orderId}}",
              "payment": "{{slots.payment}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    }
  ]
}
