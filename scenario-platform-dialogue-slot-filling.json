{
  "version": 2,
  "id": "scenario-set-platform-dialogue-slot-filling",
  "name": "Platform Dialogue State & Slot-Filling Workflow",
  "description": "Универсальный платформенный сценарий проверки Multi-Turn Dialogue State и Slot-Filling для неполных команд (PROCESS_TEST_ACTION: item + quantity).",
  "scenarios": [
    {
      "id": "sc-dialogue-process-test-action",
      "name": "Обработка тестового действия со слот-филлингом",
      "activation": {
        "type": "voice",
        "value": "voice.process-test-action"
      },
      "aliases": [
        "обработай яблоки"
      ],
      "intent": "PROCESS_TEST_ACTION",
      "requiredSlots": [
        "item",
        "quantity"
      ],
      "slotExtractors": {
        "item": {
          "type": "enum",
          "mapping": {
            "apples": [
              "яблоки",
              "яблок",
              "яблоко"
            ]
          },
          "priority": 100
        },
        "quantity": {
          "type": "integer",
          "rules": [
            {
              "pattern": "\\bпять\\b",
              "value": 5
            },
            {
              "pattern": "\\b5\\b",
              "value": 5
            }
          ],
          "priority": 100
        }
      },
      "clarificationPrompts": {
        "quantity": "Сколько?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "platform.test_action.processed",
            "payload": {
              "item": "{{slots.item}}",
              "quantity": "{{slots.quantity}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    },
    {
      "id": "sc-dialogue-process-sale",
      "name": "Продажа тестового товара",
      "aliases": [
        "продай помидоры"
      ],
      "intent": "PROCESS_SALE",
      "requiredSlots": [
        "item",
        "quantity"
      ],
      "slotExtractors": {
        "item": {
          "type": "enum",
          "mapping": {
            "tomatoes": [
              "помидоры",
              "помидор"
            ]
          },
          "priority": 100
        },
        "quantity": {
          "type": "integer",
          "rules": [
            {
              "pattern": "\\bпять\\b",
              "value": 5
            },
            {
              "pattern": "\\b5\\b",
              "value": 5
            }
          ],
          "priority": 100
        }
      },
      "clarificationPrompts": {
        "quantity": "Сколько?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "platform.test_sale.completed",
            "payload": {
              "item": "{{slots.item}}",
              "quantity": "{{slots.quantity}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    }
  ]
}
